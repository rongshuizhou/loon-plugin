#!name=零跑签到
#!desc=零跑汽车 App 签到（尽力版：定时尝试签到，极验验证需手动）
#!author=Muse
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/leapmotor.png

[MITM]
hostname = app-front-gateway.leapmotor.cn, user-growth.leapmotor.com, apptec.leapmotor.com

[Script]
# 抓取登录态：打开零跑 App 进签到页时触发，自动保存鉴权头 + deviceId
# 注意：极验验证每次签到前都会弹出，必须人工完成滑块，脚本无法代劳
http-request ^https?:\/\/app-front-gateway\.leapmotor\.cn\/app-usergrow\/app\/risk\/.* tag=零跑鉴权, script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/leapmotor_signin.js, requires-body=true, timeout=10

# 每天 9:05 尝试签到（不带极验 token；若服务端放行则成功，否则通知手动签到）
cron "*/1 * * * *" script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/leapmotor_signin.js, tag=零跑签到, timeout=60, enable=true

