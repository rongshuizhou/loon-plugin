
#!name=零跑签到
#!desc=零跑汽车 App 签到状态播报：每天查签到状态、报连续天数、提醒手动签到与抽奖（极验滑块须人工完成）
#!author=Muse
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/leapmotor.png

[MITM]
hostname = app-front-gateway.leapmotor.cn

[Script]
# 抓取登录态：打开零跑 App 进签到页时触发，自动保存鉴权头（xfx-cdn-cross-node，会轮换）
http-request ^https?:\/\/app-front-gateway\.leapmotor\.cn\/app-usergrow\/app\/risk\/.* tag=零跑鉴权, script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/leapmotor_signin.js, requires-body=true, timeout=10

# 每天 7:00 查询签到状态并通知：已签到报连续天数，未签到提醒打开 App 手滑签到
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/leapmotor_signin.js, tag=零跑签到, timeout=60, enable=true
