#!name=V2EX 签到
#!desc=V2EX 每日自动签到：抓取 Safari 登录态，cron 每天自动领取登录奖励
#!author=Muse

[MITM]
hostname = www.v2ex.com

[Script]
# 抓取登录态：Safari 打开 www.v2ex.com 任意页面时触发，自动保存 Cookie（含登录态）
http-request ^https?:\/\/www\.v2ex\.com\/.* tag=V2EX鉴权, script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/v2ex_signin.js, timeout=10

# 每天 07:00 自动签到：查签到页 → 解析 once 领取链接 → 领取
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/v2ex_signin.js, tag=V2EX签到, timeout=60, enable=true
