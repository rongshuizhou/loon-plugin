#!name=NodeSeek 签到
#!desc=NodeSeek 每日自动签到：抓取 Safari 登录态，cron 每天自动试试手气签到
#!author=Muse

[MITM]
hostname = www.nodeseek.com

[Script]
# 抓取登录态：Safari 打开 www.nodeseek.com 任意页面时触发，自动保存 Cookie（含登录态）
http-request ^https?:\/\/www\.nodeseek\.com\/.* tag=NodeSeek鉴权, script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/nodeseek_signin.js, timeout=10

# 每天 07:00 自动签到：验登录态 → 查今日状态 → 未签则 POST /api/attendance?random=true
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/rongshuizhou/loon-plugin/refs/heads/main/nodeseek_signin.js, tag=NodeSeek签到, timeout=60, enable=true
